{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/api/app/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "frontend/web/$1"
    }
  ],
  "functions": {
    "backend/api/app/main.py": {
      "runtime": "vercel-python@0.1.0"
    }
  }
}
