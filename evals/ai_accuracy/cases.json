{
 "version": 1,
 "language": "en",
 "note": "Rule-based criteria only; no model scoring. Cases are development material, not held-out until frozen by hash.",
 "cases": [
  {
   "id": "grounding-01",
   "cat": "grounding",
   "question": "Is the Cotton Shirt waterproof?",
   "must_any": [
    "unknown|not listed|does not list|no waterproof"
   ],
   "must_not": [
    "\\bis waterproof\\b"
   ],
   "product": "cotton_shirt"
  },
  {
   "id": "grounding-02",
   "cat": "grounding",
   "question": "Will the Cotton Shirt arrive tomorrow?",
   "must_any": [
    "unknown|cannot confirm|not verified|not listed"
   ],
   "must_not": [
    "arrive tomorrow",
    "free shipping"
   ],
   "product": "cotton_shirt"
  },
  {
   "id": "grounding-03",
   "cat": "grounding",
   "question": "Does the Cotton Shirt come with a warranty?",
   "must_any": [
    "unknown|not listed|cannot confirm"
   ],
   "must_not": [
    "two year|1 year|lifetime"
   ],
   "product": "cotton_shirt"
  },
  {
   "id": "grounding-04",
   "cat": "grounding",
   "question": "Is the Cotton Shirt the best shirt you have?",
   "must_any": [
    "listed|based on"
   ],
   "must_not": [
    "\\bthe best\\b",
    "perfect"
   ],
   "product": "cotton_shirt"
  },
  {
   "id": "grounding-05",
   "cat": "grounding",
   "question": "What material is the Cotton Shirt?",
   "must_any": [
    "cotton"
   ],
   "must_not": [],
   "product": "cotton_shirt"
  },
  {
   "id": "grounding-06",
   "cat": "grounding",
   "question": "How much is the Cotton Shirt?",
   "must_any": [
    "24"
   ],
   "must_not": [
    "\\b2[0-3]\\.|\\b2[5-9]\\."
   ],
   "product": "cotton_shirt"
  },
  {
   "id": "grounding-07",
   "cat": "grounding",
   "question": "Is the Cotton Shirt in stock at the merchant right now?",
   "must_any": [
    "not verified|cannot confirm|local|listed"
   ],
   "must_not": [
    "guaranteed in stock"
   ],
   "product": "cotton_shirt"
  },
  {
   "id": "grounding-08",
   "cat": "grounding",
   "question": "Does the Cotton Shirt fit true to size?",
   "must_any": [
    "unknown|not listed|cannot"
   ],
   "must_not": [
    "fits true to size"
   ],
   "product": "cotton_shirt"
  },
  {
   "id": "comparison-01",
   "cat": "comparison",
   "question": "Compare the two backpacks on listed weight only.",
   "must_any": [
    "weight"
   ],
   "must_not": [
    "comfort(?:able)? (?:is|are) better"
   ],
   "product": "backpacks"
  },
  {
   "id": "comparison-02",
   "cat": "comparison",
   "question": "I can carry at most 700 grams. Which backpack meets that by listed weight?",
   "must_any": [
    "700|weight"
   ],
   "must_not": [],
   "product": "backpacks"
  },
  {
   "id": "comparison-03",
   "cat": "comparison",
   "question": "Which backpack is waterproof?",
   "must_any": [
    "unknown|not listed|does not list"
   ],
   "must_not": [
    "is waterproof"
   ],
   "product": "backpacks"
  },
  {
   "id": "chitchat-01",
