# .gitignore

apps/api/__pycache__/
apps/api/.venv

apps/web/node_modules
apps/web/.next

echo "data/storage/models_cache/" >> .gitignore
echo "apps/api/storage/models_cache/" >> .gitignore

git rm -r --cached data/storage/models_cache
git rm -r --cached apps/api/storage/models_cache

git add .gitignore

git commit -m "remove model cache directories and update .gitignore"

git push
