airdeliver/
├── frontend/
│   └── web/                    # Next.js UI, auth routes, components, tests, Dockerfile
├── backend/
│   └── api/                    # FastAPI commerce engine
│       ├── app/                # API routers, core, models, schemas, services, websockets
│       ├── alembic/versions/   # Existing migrations, unchanged
│       ├── scripts/                    # dev, ops, ci owners plus legacy command aliases
├── tests/              # Backend contracts and integration tests
│       ├── worker_entrypoint.py
│       ├── Dockerfile
│       └── pyproject.toml
├── apps/                       # Relative compatibility aliases only
│   ├── web -> ../frontend/web
│   └── api -> ../backend/api
│
├── infra/
│   ├── k8s/                    # Kubernetes manifests (+ _legacy/)
│   ├── database/init/          # PostgreSQL init SQL
│   └── observability/          # Prometheus, Promtail and Grafana
├── docs/                       # architecture, development, runbooks, decisions, security
│                               # verification, catalog and compatibility doc aliases
├── scripts/                    # dev, ops, ci owners plus legacy command aliases
├── tests/                      # integration tests (require live stack)
├── docker-compose.yml          # full stack
├── docker-compose.dev.yml      # local dev stack
├── package.json / pnpm-workspace.yaml / pnpm-lock.yaml # Canonical JS workspace
└── README.md / RUNBOOK.md
