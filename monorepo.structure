airdeliver/
├── apps/
│   ├── api/                    # FastAPI backend (AI commerce engine)
│   │   ├── alembic/versions/   # DB migrations
│   │   ├── app/
│   │   │   ├── api/v1/         # REST routers (endpoints/ + api.py)
│   │   │   ├── core/           # config, security
│   │   │   ├── crud/
│   │   │   ├── db/
│   │   │   ├── models/         # SQLModel tables
│   │   │   ├── schemas/        # Pydantic DTOs
│   │   │   ├── services/       # AI cores, cart/checkout, payments
│   │   │   ├── websockets/     # AI chat channel
│   │   │   └── main.py
│   │   ├── tests/
│   │   ├── worker_entrypoint.py # RabbitMQ consumer (voice path + legacy queues)
│   │   ├── Dockerfile
│   │   └── pyproject.toml
│   │
│   └── web/                    # Next.js frontend
│       ├── app/
│       │   ├── (admin)/dashboard/
│       │   ├── (main)/         # about, cart, checkout, products, tracking/[orderId], ...
│       │   ├── api/auth/[...nextauth]/
│       │   ├── legal/          # privacy-policy, terms-of-service
│       │   └── help/
│       ├── components/
│       ├── hooks/
│       └── Dockerfile
│
├── infra/
│   ├── k8s/                    # Kubernetes manifests (+ _legacy/)
│   ├── database/init/          # PostgreSQL init SQL
│   └── observability/          # Prometheus, Promtail and Grafana
├── docs/                       # ops docs (security/, INCIDENT_RESPONSE.md, ...)
├── tests/                      # integration tests (require live stack)
├── docker-compose.yml          # full stack
├── docker-compose.dev.yml      # local dev stack
└── README.md / RUNBOOK.md
