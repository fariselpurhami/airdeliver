# LOCAL DEVELOPMENT ONLY. Do not copy this over an existing .env.
# Run the dev-setup helper to preserve local credentials and generate missing
# secrets directly on your Mac. Its output .env.dev and secrets/dev are ignored.
# Equivalent manual secret generation: openssl rand -hex 32
AIRDELIVER_ENV_FILE=.env.dev
AIRDELIVER_DEV_SECRET_DIR=./secrets/dev
COMPOSE_PROJECT_NAME=airdeliver_dev
APP_ENV=development
HOST_IP=127.0.0.1
API_BASE_URL=http://127.0.0.1
ALGORITHM=HS256
SECRET_KEY=
REFRESH_SECRET_KEY=
INTERNAL_API_TOKEN=
FIRST_SUPERUSER=dev-admin@example.com
FIRST_SUPERUSER_PASSWORD=
COOKIES_SECURE=false
BACKEND_CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# Preserve these from existing .env or original secrets/ files. Do not invent
# replacement DB credentials for an existing volume. The helper refuses to.
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL_ASYNC=
DATABASE_URL_SYNC=
USE_REDIS=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RABBITMQ_HOST=mq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_COOKIE=

AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000
NEXTAUTH_URL=http://127.0.0.1:3000
AUTH_TRUST_HOST=true
NEXT_PUBLIC_API_URL=http://127.0.0.1/api/v1
API_URL=http://api:8000/api/v1
BACKEND_API_URL=http://api:8000

OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_ADMIN_PASSWORD=
MILVUS_URI=http://milvus:19530
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_TOKEN=
# Legacy MinIO values retained for rollback only, not used by new dev storage.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
GRAFANA_USER=dev-admin
GRAFANA_PASSWORD=
TRAEFIK_DASHBOARD_USER=dev-admin
TRAEFIK_DASHBOARD_PASS_HASH=
ACME_EMAIL=dev-admin@example.com

# Optional. Blank means unconfigured, never a fake payment success.
# Add Stripe TEST keys locally only, never live keys or keys in chat.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CHECKOUT_ORIGIN=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
GROQ_API_KEY=
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional Hugging Face read token, enter only in your local ignored .env.dev.
# Public models work without it; authentication can improve download limits.
# Cache hits avoid weight downloads, not necessarily Hub metadata requests.
HF_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Do not choose from your location. Needed only for populated legacy naive
# timestamp columns, after verifying what those historical values represent.
LEGACY_TIMESTAMP_TIMEZONE=

# RustFS local development only. Helper generates these privately for new setups.
DEV_S3_ACCESS_KEY=
DEV_S3_SECRET_KEY=

# Intent router. Native Groq SDK takes a root URL, not /openai/v1.
GROQ_SUPPORT_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com

# Local admission capacity only. Does not subscribe, spend or verify your account.
# Keep free until your organization's current limits confirm otherwise.
PROVIDER_CAPACITY_PLAN=free
PROVIDER_PLAN_TPM_LIMIT=8000
PROVIDER_TPM_HEADROOM_PERCENT=10
# Optional lower override; unset derives7200 for free,225000 for developer250000.
# PROVIDER_TPM_BUDGET=7200
# Owner-enabled Developer example AFTER plan/organization limit verification:
# PROVIDER_CAPACITY_PLAN=developer
# PROVIDER_PLAN_TPM_LIMIT=250000
# PROVIDER_TPM_HEADROOM_PERCENT=10

# Optional exact-model cost estimates only. No billing/spend authority.
# PROVIDER_COST_MODEL=openai/gpt-oss-120b
# PROVIDER_INPUT_MICRO_USD_PER_MILLION=150000
# PROVIDER_OUTPUT_MICRO_USD_PER_MILLION=600000

# Optional private HTTPS for a phone (Tailscale Serve). Exact tailnet name, e.g. my-mac.tailXXXX.ts.net. Empty keeps LAN-IP-only access.
# DEV_PUBLIC_HOST=
