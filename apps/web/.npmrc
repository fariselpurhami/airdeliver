# ==============================================================================
# ENTERPRISE-GRADE PNPM CONFIGURATION (.npmrc)
# Target Architecture: High-Performance AI E-Commerce Engine
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BLEEDING-EDGE & RUNTIME FREEDOM
# ------------------------------------------------------------------------------
# Allow installing packages immediately upon publication (disable 24h delay)
minimum-release-age=0

# Disable automatic lockfile verification check on `pnpm dev` to prevent server hangs
verify-deps-before-run=false

# ------------------------------------------------------------------------------
# 2. DEPENDENCY RESOLUTION & REPRODUCIBILITY
# ------------------------------------------------------------------------------
# Automatically install missing peer dependencies
auto-install-peers=true

# Prevent build failures due to non-critical peer dependency conflicts
strict-peer-dependencies=false

# Deduplicate top-level dependencies to optimize memory and speed
dedupe-direct-deps=true

# Enforce lockfile compliance in CI/Docker environments
prefer-frozen-lockfile=true

# ------------------------------------------------------------------------------
# 3. PERFORMANCE & DOCKER RESILIENCE
# ------------------------------------------------------------------------------
# Network retry policy for high reliability inside Docker containers
fetch-retries=5
fetch-retry-maxtimeout=60000
fetch-timeout=60000

# Cache side-effects to accelerate incremental builds
side-effects-cache=true

# ------------------------------------------------------------------------------
# 4. HOISTING & NEXT.JS COMPATIBILITY
# ------------------------------------------------------------------------------
# Hoist common toolchain dependencies to prevent "Module Not Found" issues
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@types/*

# ------------------------------------------------------------------------------
# 5. CLEAN DX & NOISE REDUCTION
# ------------------------------------------------------------------------------
# Suppress unnecessary CLI noise and telemetry prompts
fund=false
audit=false
update-notifier=false
