# =============================================================================
# airdeliver - Environment template (NO REAL VALUES - copy to .env and fill)
# .env is gitignored. Never commit real values.
# =============================================================================

# --- Core API ---
APP_ENV=development                  # development | staging | production
API_BASE_URL=http://localhost:8000
API_V1_STR=/api/v1
SECRET_KEY=change-me-min-32-chars-long-random-string
REFRESH_SECRET_KEY=change-me-min-32-chars-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520
REFRESH_TOKEN_EXPIRE_MINUTES=10080
COOKIES_SECURE=true
INTERNAL_API_TOKEN=change-me-internal-service-token
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me-strong-password
WEB_CONCURRENCY=1

# --- PostgreSQL ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=airdeliver
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airdeliver
DATABASE_URL_ASYNC=postgresql+asyncpg://airdeliver:change-me@postgres:5432/airdeliver
DATABASE_URL_SYNC=postgresql+psycopg2://airdeliver:change-me@postgres:5432/airdeliver

# --- Redis ---
USE_REDIS=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ ---
RABBITMQ_HOST=mq
RABBITMQ_PORT=5672
RABBITMQ_USER=airdeliver
RABBITMQ_PASS=change-me
RABBITMQ_COOKIE=change-me-erlang-cookie

# --- AI providers ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
HF_TOKEN=
HF_HOME=/data/huggingface

# --- Vector / Search infra ---
MILVUS_URI=http://milvus:19530
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_TOKEN=
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=change-me
OPENSEARCH_ADMIN_PASSWORD=change-me
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# --- MinIO (Milvus object storage) ---
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://example.com/webhooks/mpesa

# --- Push notifications (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=


# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-random-string
AUTH_SECRET=change-me-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
BACKEND_API_URL=http://api:8000

# --- Observability / proxy ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASS_HASH=change-me-bcrypt-hash
ACME_EMAIL=you@example.com

# --- Misc / tooling ---
COMPOSE_PROJECT_NAME=airdeliver
HOST_IP=127.0.0.1
NGROK_AUTHTOKEN=
BATCH_SIZE=100
TARGET_COUNT=1000
