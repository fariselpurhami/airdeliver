# frontend/web - copy to .env.local and fill. .env.local is gitignored.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-random-string
# WebSocket origin for chat/voice (production: wss://api.airdeliver.com). Leave unset to derive from window.location.
NEXT_PUBLIC_WS_URL=
